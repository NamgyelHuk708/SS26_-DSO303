{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTheEdgeLogGroups",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/usms-edge-*",
        "arn:aws:logs:*:000000000000:log-group:/aws/lambda/us-east-1.usms-edge-*"
      ]
    },
    {
      "Sid": "WriteTheEdgeLogStreams",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/usms-edge-*:*",
        "arn:aws:logs:*:000000000000:log-group:/aws/lambda/us-east-1.usms-edge-*:*"
      ]
    }
  ]
}
